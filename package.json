{
  "name": "pi-serve-static",
  "version": "0.1.0",
  "description": "A pi extension that serves the current working directory over a local static HTTP server (/serve-start, /serve-stop)",
  "license": "MIT",
  "author": "Richard Anaya <richard.anaya@gmail.com>",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "node --input-type=module -e \"import fs from 'node:fs'; fs.accessSync('index.ts')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardanaya/pi-serve-static.git"
  },
  "bugs": {
    "url": "https://github.com/richardanaya/pi-serve-static/issues"
  },
  "homepage": "https://github.com/richardanaya/pi-serve-static#readme",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "cli",
    "tui",
    "static-server",
    "http",
    "preview",
    "browser",
    "local-server"
  ],
  "publishConfig": {
    "access": "public"
  }
}
